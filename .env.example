# Copy this file to .env and fill it in. Never commit .env.

# Tracing videos pick their words with Claude Haiku 5.5 (well under a cent a video):
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Free key: https://console.groq.com/keys (vision check, story videos)
GROQ_API_KEY=

# Milestone 2 (pictures): free Cloudflare account -> Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: trace every run in LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
